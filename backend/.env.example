# ==============================================================================
# CALZARE FOOTWEAR — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in production: cp .env.example .env
# 2. Populate real production secrets and credentials before launching.
# 3. Ensure this file is never committed into version control.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=*

# Database Connection — MongoDB Community Server (Pre-configured for local Bluehost VPS)
MONGO_URI=mongodb://calzare_admin:CalzarePassword2026!@127.0.0.1:27017/calzare_production?authSource=admin

# JWT Authentication
JWT_SECRET=super_secret_jwt_calzare_8492049182390123984918230912
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay India — Simulated fallback until you add live keys)
RAZORPAY_KEY_ID=rzp_test_calzare12345
RAZORPAY_KEY_SECRET=calzareRazorpaySecretTest98765
RAZORPAY_WEBHOOK_SECRET=MyCalzareRzpWebhook2026

# Transactional Email Delivery (SMTP Service e.g. Amazon SES, Postmark, Brevo, SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL="CALZARE Orders <orders@calzarefootwear.com>"

# Media Asset Storage
# Options: 'local' (writes to /uploads directory) or 's3' / 'cloudinary'
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# FShip Logistics & Courier Aggregator (fship.in)
# Obtain signature / API key from https://app.fship.in/setting/additional/user-management
FSHIP_API_KEY=68e1a2b5a61128696f34531432751be18eaea96aea6ea1aa093ff8b54c4b0507
FSHIP_BASE_URL=https://capi.fship.in
FSHIP_PICKUP_PINCODE=560038

# Optional Analytics & Search Console IDs
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
META_PIXEL_ID=0000000000000000
