# ==============================================================================
# CALZARE FOOTWEAR — FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# In production, set these variables in your hosting provider (Vercel, Netlify, Render, Cloudflare)
# ==============================================================================

# API Base URL (leave empty if frontend and backend share same origin via reverse proxy)
VITE_API_URL=https://api.calzarefootwear.com

# Razorpay Client-side Key ID (Test key starts with rzp_test_, Production key starts with rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
