# ==============================================================================
# CALZARE FOOTWEAR — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in production: cp .env.example .env
# 2. Populate real production secrets and credentials before launching.
# 3. Ensure this file is never committed into version control.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://calzarefootwear.com

# Database Connection (MongoDB Atlas or Self-Hosted Production Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/calzare_production?retryWrites=true&w=majority

# JWT Authentication
# Generate a cryptographically strong secret using: openssl rand -base64 64
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key_here
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay India)
# Required for live transactions: Sign up at https://dashboard.razorpay.com and generate Live API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Transactional Email Delivery (SMTP Service e.g. Amazon SES, Postmark, Brevo, SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL="CALZARE Orders <orders@calzarefootwear.com>"

# Media Asset Storage
# Options: 'local' (writes to /uploads directory) or 's3' / 'cloudinary'
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Optional Analytics & Search Console IDs
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
META_PIXEL_ID=0000000000000000
