# ==============================================================================
# CALZARE FOOTWEAR — NGINX VIRTUAL HOST CONFIGURATION FOR BLUEHOST VPS
# Place in: /etc/nginx/sites-available/calzare.conf
# Enable:   ln -s /etc/nginx/sites-available/calzare.conf /etc/nginx/sites-enabled/
# ==============================================================================

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com api.yourdomain.com;

    # Client body limit for product media uploads
    client_max_body_size 25M;

    # 1. Frontend Static Assets & SPA Routing
    location / {
        root /var/www/calzare/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Cache static assets (images, fonts, bundles)
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webp)$ {
            expires 30d;
            add_header Cache-Control "public, no-transform";
        }
    }

    # 2. Reverse Proxy to Node.js REST API Backend
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # 3. Serve Uploaded Media Files directly from Node backend
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
        expires 7d;
    }
}

